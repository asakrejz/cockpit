<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for launchd: starts Cockpit at login. Nothing is installed automatically.

  1. Copy this file to ~/Library/LaunchAgents/de.cockpit.server.plist.
  2. Replace the two placeholders:
       /PFAD/ZUM/REPO    the folder of this repo (absolute, without ~)
       /Users/BENUTZER   your home directory (for the log file and PATH)
  3. Run `scripts/start.sh` once by hand so that server and app are built.
  4. Load:   launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/de.cockpit.server.plist
     Unload: launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/de.cockpit.server.plist
  The log is in /Users/BENUTZER/Library/Logs/cockpit-server.log.

  Own settings (COCKPIT_PORT, COCKPIT_DB, COCKPIT_SEED, …) belong in the file config.toml or
  below in EnvironmentVariables. Keys never belong here: they are in the `.env` file in the project folder (WorkingDirectory must be the repo)
  (`cockpit-server token setzen …`).

  The label `de.cockpit.server` stays unchanged on purpose: an already loaded agent keeps working
  and `launchctl bootout` still finds it.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>de.cockpit.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/PFAD/ZUM/REPO/scripts/start.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/PFAD/ZUM/REPO</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/Users/BENUTZER/.cargo/bin:/usr/bin:/bin</string>
  </dict>

  <!-- Start at login. If the server ends with an error, launchd does not restart it. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/BENUTZER/Library/Logs/cockpit-server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/BENUTZER/Library/Logs/cockpit-server.log</string>
</dict>
</plist>
