<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for launchd: starts Cockpit at login. Nothing is installed automatically.

  1. Copy this file to ~/Library/LaunchAgents/de.cockpit.server.plist.
  2. Replace the two placeholders:
       /PATH/TO/REPO   the folder of this repo (absolute, without ~)
       /Users/YOUR_USER   your home directory (for the log file and PATH)
  3. Run `scripts/start.sh` once by hand so that server and app are built.
  4. Load:   launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/de.cockpit.server.plist
     Unload: launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/de.cockpit.server.plist
  The log is in /Users/YOUR_USER/Library/Logs/cockpit-server.log.

  WorkingDirectory below must be the repo: the server finds the project folder from it, so
  `config/config.toml`, `config/cockpit.db` and `.env` are always the ones of the repo.
  Own settings (COCKPIT_PORT, COCKPIT_SEED, …) belong in `config/config.toml` or below in
  EnvironmentVariables (COCKPIT_CONFIG and COCKPIT_DB override the places). Keys never belong
  here: they are in the `.env` file in the project folder (`cockpit-server token set …`).

  The label `de.cockpit.server` stays unchanged on purpose: an already loaded agent keeps working
  and `launchctl bootout` still finds it.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>de.cockpit.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/PATH/TO/REPO/scripts/start.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/PATH/TO/REPO</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/Users/YOUR_USER/.cargo/bin:/usr/bin:/bin</string>
  </dict>

  <!-- Start at login. If the server ends with an error, launchd does not restart it. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USER/Library/Logs/cockpit-server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USER/Library/Logs/cockpit-server.log</string>
</dict>
</plist>
