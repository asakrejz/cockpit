# Image of the Cockpit agent. Builds the same with Docker and Podman:
#   docker build -f apps/agent/Containerfile -t localhost/cockpit-agent:local apps/agent
#   podman build -f apps/agent/Containerfile -t localhost/cockpit-agent:local apps/agent
# (the backend does that via "Build image" in the setup assistant and adds the label
# `cockpit.fingerprint`, by which it recognises an outdated image; no tag to raise).
# Everything copied below (runner/package*.json, runner/src, clis/package*.json) and this file
# go into that fingerprint.
# Deliberately without BuildKit special features (no "# syntax=", no "RUN --mount") and with a fully
# named base image, because Podman does not resolve short names without further ado.
FROM docker.io/library/node:26-trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    # The mounted repo belongs to a different id on the host than the runner.
    && git config --system --add safe.directory /work \
    && mkdir -p /work /job && chown node:node /work

WORKDIR /opt/runner
COPY runner/package.json runner/package-lock.json ./
RUN npm ci --omit=dev
COPY runner/src ./src

# The agent CLIs of the adapters `claude-code` and `codex`: exact versions from their own lockfile
# (`npm ci`, never "latest"), kept apart from the runner so the runner tests stay light.
# Nothing secret is written here: no .npmrc, no login, the keys only arrive at run time via `-e NAME`.
WORKDIR /opt/clis
COPY clis/package.json clis/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# The runner never works as root.
USER node
WORKDIR /work
ENV HOME=/home/node \
    COCKPIT_JOB=/job/job.json \
    COCKPIT_ROOT=/work \
    COCKPIT_PROVIDER=claude-agent-sdk \
    PATH=/opt/clis/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    DISABLE_AUTOUPDATER=1 \
    NODE_ENV=production

ENTRYPOINT ["node", "/opt/runner/src/main.ts"]
