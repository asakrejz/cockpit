# Image of the Cockpit agent. Builds the same with Docker and Podman:
#   docker build -f apps/agent/Containerfile -t localhost/cockpit-agent:4 apps/agent
#   podman build -f apps/agent/Containerfile -t localhost/cockpit-agent:4 apps/agent
# (the backend does that via "Image bauen" in the setup assistant).
# Deliberately without BuildKit special features (no "# syntax=", no "RUN --mount") and with a fully
# named base image, because Podman does not resolve short names without further ado.
FROM docker.io/library/node:24-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    # The mounted repo belongs to a different id on the host than the runner.
    && git config --system --add safe.directory /work \
    && mkdir -p /work /job && chown node:node /work

WORKDIR /opt/runner
COPY runner/package.json runner/package-lock.json ./
RUN npm ci --omit=dev
COPY runner/src ./src

# The runner never works as root.
USER node
WORKDIR /work
ENV HOME=/home/node \
    COCKPIT_JOB=/job/job.json \
    COCKPIT_ROOT=/work \
    COCKPIT_PROVIDER=claude-agent-sdk \
    NODE_ENV=production

ENTRYPOINT ["node", "--disable-warning=ExperimentalWarning", "/opt/runner/src/main.ts"]
