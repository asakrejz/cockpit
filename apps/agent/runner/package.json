{
  "name": "cockpit-agent-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Läufer des Cockpit-Agenten: führt einen Auftrag mit dem Claude Agent SDK aus und meldet JSON-Zeilen auf stdout",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.322",
    "@anthropic-ai/sdk": "1.8.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
