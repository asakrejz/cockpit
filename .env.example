# Cockpit credentials. Copy this file to `.env` in the project folder and fill in your values:
#
#   cp .env.example .env
#
# `.env` is ignored by Git. NEVER commit it, never paste real values into this example file.
# The setup page in the app can write these values for you; the file stays on this computer.
# A real environment variable with the same name takes precedence over the file.
# Values with special characters go in single quotes: NAME='value'.

# Jira API token. Create it at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=dummy-jira-api-token

# GitHub personal access token (fine-grained, read-only is enough for syncing).
GITHUB_TOKEN=dummy-github-token

# Key for the model endpoint of the agent (LiteLLM, Anthropic, OpenAI, ...); the same key name for every provider
# (claude-agent-sdk, claude-code, codex). Old name: LITELLM.
AGENT_KEY=dummy-agent-key

# Client secret of your GitHub App / OAuth App (Settings > Developer settings).
GITHUB_OAUTH_CLIENT_SECRET=dummy-github-oauth-client-secret

# Client secret of your Atlassian OAuth 2.0 (3LO) app (https://developer.atlassian.com/console).
ATLASSIAN_OAUTH_CLIENT_SECRET=dummy-atlassian-oauth-client-secret

# Written by the backend after you sign in (compact one-line JSON in single quotes). Do not edit.
GITHUB_OAUTH_TOKENS='{"access":"dummy-access","refresh":"dummy-refresh"}'
ATLASSIAN_OAUTH_TOKENS='{"access":"dummy-access","refresh":"dummy-refresh"}'
